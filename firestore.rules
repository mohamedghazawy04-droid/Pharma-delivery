rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // System state for cross-environment central synchronization
    match /system/{docId} {
      allow read, write: if true;
    }

    // Pharmacies: Read & write allowed for active management
    match /pharmacies/{pharmacyId} {
      allow read, write: if true;
    }

    // Couriers: Read & write allowed for registration and live tracking
    match /couriers/{courierId} {
      allow read, write: if true;
    }

    // Orders: Read & write allowed for order dispatch and delivery
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Shift summaries: Read & write allowed for shift closures
    match /shiftSummaries/{summaryId} {
      allow read, write: if true;
    }

    // Test connection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
